{
  "name": "all-easy-gym-life",
  "private": true,
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "npm run backend:dev",
    "dev:backend": "npm run backend:dev",
    "dev:frontend": "npm run flutter:web",
    "install:backend": "npm install --workspace backend",
    "backend:dev": "npm run dev --workspace backend",
    "backend:start": "npm run start --workspace backend",
    "backend:seed": "npm run seed:demo --workspace backend",
    "flutter:run": "flutter run",
    "flutter:web": "flutter run -d web-server --web-hostname localhost --web-port 8080"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
